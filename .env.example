# Local database and auth (Vercel uses Production values for these)
DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"

# Email notifications via FormSubmit
NOTIFY_EMAIL="your-notify-address@example.com"
SITE_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Optional: after FormSubmit activation, set the alias to hide the real email
FORMSUBMIT_ALIAS=""
