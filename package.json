{
  "name": "tours-transfers-bookings",
  "private": true,
  "scripts": {
    "predev": "prisma generate --schema prisma/schema.prisma",
    "dev": "next dev",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "build": "next build",
    "vercel-build": "prisma generate --schema prisma/schema.postgres.prisma && prisma db push --schema prisma/schema.postgres.prisma --skip-generate && next build",
    "prestart": "prisma generate --schema prisma/schema.prisma",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db": "prisma db push --schema prisma/schema.prisma",
    "db:postgres": "prisma db push --schema prisma/schema.postgres.prisma"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "typescript": "5.6.3",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1"
  }
}
