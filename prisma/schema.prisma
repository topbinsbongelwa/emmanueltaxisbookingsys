generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("staff")
  createdAt DateTime @default(now())
  devices   Device[]
  outgoingLinks AccountLink[] @relation("LinkRequester")
  incomingLinks AccountLink[] @relation("LinkRecipient")
  notifications Notification[]
}

model Booking {
  id        String   @id @default(cuid())
  date      String
  time      String
  type      String   @default("transfer")
  pickup    String
  dest      String
  pax       Int      @default(1)
  guest     String   @default("")
  email     String   @default("")
  phone     String   @default("")
  driver    String   @default("")
  vehicle   String   @default("")
  notes     String   @default("")
  status    String   @default("booked")
  reminderSent Boolean @default(false)
  // 1-day-before digest email timestamp; null until a reminder is delivered.
  reminderSentAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
}

/// Delivery history shown in the dashboard "Email notifications" section.
model NotificationLog {
  id        String   @id @default(cuid())
  bookingId String?
  type      String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  read      Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AccountLink {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("LinkRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("LinkRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@unique([requesterId, recipientId])
}

model Device {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SignupVerification {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  sentAt    DateTime
  attempts  Int      @default(0)
}
